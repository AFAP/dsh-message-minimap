{
  "name": "dsh-message-minimap",
  "version": "0.7.0",
  "description": "用户消息导航条插件：在 DeepSeek Harness Web GUI 会话聊天窗右侧显示一条迷你导航条（minimap，官方轮次轨道在左侧），用刻度标出全部用户轮次（含未加载历史，取自官方 turnOutline 投影），悬停预览提示词与发送日期时间（未加载轮次由宿主轻量 messageMinimapTimes 投影补齐），点击/拖动即可快速跳转定位（未加载轮次按官方 loadThrough(seq) 精确翻页）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFAP/dsh-message-minimap.git"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "files": [
    "lib/index.js",
    "lib/projection.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "minimap",
    "navigation",
    "user-message",
    "scrollbar",
    "plugin"
  ],
  "license": "MIT"
}
